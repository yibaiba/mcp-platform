# cp .env.example .env; generate secrets with the commands in README.md.
DATABASE_URL=postgresql://platform:CHANGE_LOCALLY@localhost:5432/platform
PUBLIC_URL=http://localhost:4300
WEB_ORIGIN=http://localhost:4301
PORT=4300
# Apps resources share the backend's /_apps/* routes.
DATA_DIR=.data
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Independent 32-byte canonical Base64 key; protect and back up separately.
DEVICE_AUTH_ENCRYPTION_KEY=
ALLOW_REGISTRATION=false
# Optional SSO provider JSON; inject client secrets through deployment configuration.
# AUTH_PROVIDERS={"google":{"clientId":"<client-id>","clientSecret":"<secret>"}}
METRICS_ENABLED=false
# METRICS_TOKEN must be an independent secret of at least 32 characters when enabled.
# CALL_RETENTION_DAYS and LOG_RETENTION_DAYS are unset by default (no automatic cleanup).
# Platform-host stdio (direct/Pi adapters spawn processes on this server). Off by default;
# when true only admins may create, update or start such connections. Child processes receive
# only PATH/HOME/USER/SHELL/TERM/LOGNAME, locale/TMPDIR, uv paths and the connection's own env.
PLATFORM_STDIO_ENABLED=false
# Enables built-in inference tasks only. MCP connections and Pi bridging need no model.
PI_ENABLED=false
PI_MODEL_PROVIDER=
PI_MODEL_ID=
PI_MCP_ADAPTER_OAUTH_FILE_KEY=
# Request limits per minute, counted in memory per server process (0 turns one limit off).
# MCP: per access key / OAuth grant, per user, and per client address before authentication.
# AUTH: OAuth register/authorize/token/revoke, CLI login, device pairing and /api/v1/auth/*
# (session reads exempt). LOGIN: sign-in and sign-up attempts per client address.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MCP_PER_CREDENTIAL=600
# RATE_LIMIT_MCP_PER_USER=1200
# RATE_LIMIT_MCP_PER_IP=2400
# RATE_LIMIT_AUTH_PER_IP=120
# RATE_LIMIT_LOGIN_PER_IP=20
# Hops trusted to set X-Forwarded-For: none, loopback, private, or CIDRs. The default fits a
# reverse proxy on the same host or Docker network; use none when clients connect directly
# from a private network, or list your proxy's address.
# IMPORTANT: clients on a LAN reaching port 4300 directly (no reverse proxy) MUST set
# TRUSTED_PROXIES=none, otherwise they can forge X-Forwarded-For and evade per-address limits.
# TRUSTED_PROXIES=loopback,private
# Production: PUBLIC_URL and WEB_ORIGIN must both be the actual public origin.
# Optional startup manifest envelope (declaration, mappings, mode) and explicit existing owner.
# CONFIG_MANIFEST_FILE=/app/.data/config.json
# CONFIG_MANIFEST_OWNER=operator@example.test
