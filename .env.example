# cp .env.example .env; generate secrets with the commands in README.md.
DATABASE_URL=postgresql://platform:CHANGE_LOCALLY@localhost:5432/platform
PUBLIC_URL=http://localhost:4300
WEB_ORIGIN=http://localhost:4301
PORT=4300
# Separate MCP Apps sandbox origin. Production defaults to https://apps.<PUBLIC_URL host>.
APPS_PORT=4302
APPS_ORIGIN=http://localhost:4302
DATA_DIR=.data
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
ALLOW_REGISTRATION=false
# Enables built-in inference tasks only. MCP connections and Pi bridging need no model.
PI_ENABLED=false
PI_MODEL_PROVIDER=
PI_MODEL_ID=
PI_MCP_ADAPTER_OAUTH_FILE_KEY=
# Compose: DOMAIN is a hostname, PUBLIC_URL and WEB_ORIGIN must both be https://DOMAIN.
DOMAIN=
# Compose: APPS_ORIGIN=https://apps.your-domain; configure DNS to the same deployment.
APPS_DOMAIN=
POSTGRES_PASSWORD=
