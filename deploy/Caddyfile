{$DOMAIN} {
  encode zstd gzip
  @backend path /api/* /mcp/* /.well-known/* /health
  handle @backend {
    reverse_proxy server:4300 {
      flush_interval -1
    }
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}

{$APPS_DOMAIN} {
  reverse_proxy server:4302
}
