# Copy to .env beside docker-compose.yml and fill every required value.
# Use a published unified image containing mcp-manger PR #3; a commit is not an image tag.
PLATFORM_IMAGE_PREFIX=ghcr.io/yibaiba/mcp-manger-platform
PLATFORM_VERSION=
# PostgreSQL is included; DATABASE_URL is supplied by Compose.
# Generate a URL-safe password: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:4300
WEB_ORIGIN=http://localhost:4300
# Generate BETTER_AUTH_SECRET: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Run separately for each key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
DEVICE_AUTH_ENCRYPTION_KEY=
# Enable for initial signup; disable and recreate the container afterwards.
ALLOW_REGISTRATION=false
PI_ENABLED=false
PI_MODEL_PROVIDER=
PI_MODEL_ID=
PI_MCP_ADAPTER_OAUTH_FILE_KEY=
