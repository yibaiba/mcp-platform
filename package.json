{
  "name": "platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "check-types": "tsc --noEmit && pnpm --filter @platform/pi-runtime check-types && pnpm --filter web check-types",
    "lint": "eslint apps packages integrations/pi/src tests --max-warnings 0",
    "format": "prettier --write apps packages tests integrations/pi/src scripts docs *.json *.yaml *.mjs",
    "test": "node scripts/test.mjs",
    "db:generate": "pnpm --filter @platform/db db:generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "start": "tsx apps/server/src/index.ts",
    "connector:build": "node scripts/build-connector.mjs",
    "test:pi": "node scripts/check.mjs 60 pnpm exec tsx tests/pi-smoke.mts",
    "backup": "node scripts/backup.mjs",
    "user:role": "tsx scripts/user-role.mts"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "1.14.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@platform/pi-runtime": "workspace:*",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "drizzle-orm": "0.45.2",
    "eslint": "10.9.1",
    "globals": "16.5.0",
    "hono": "4.13.11",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
