{
  "name": "@platform/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "node --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.8",
    "@types/pg": "8.15.6",
    "typescript": "catalog:",
    "@platform/config": "workspace:*"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@platform/contracts": "workspace:*"
  }
}
